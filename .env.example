# ─── Notery Backend Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in your values.
# Lines starting with # are comments. Remove # to enable a variable.

# ─── Environment ────────────────────────────────────────────────────────────
# Set to "production" to enforce strict security checks (required JWT_SECRET,
# DB SSL, Stripe webhook secret, etc.). Leave unset or "development" for local dev.
ENVIRONMENT=development

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=changeme
DB_NAME=notery_db
DB_SSLMODE=disable
DB_TIMEZONE=UTC
# Connection pool (optional, sensible defaults applied)
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME_SEC=300
# DB_CONN_MAX_IDLE_SEC=60

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Meilisearch ────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=
MEILISEARCH_INDEX=notes

# ─── JWT ────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=

# ─── Stripe (Payments) ─────────────────────────────────────────────────────
# Leave empty for dev mode (auto-fulfil purchases).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Cloudflare R2 / MinIO (File Storage) ──────────────────────────────────
# Leave empty for dev mode (file storage disabled).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=notery-pdfs
# For local MinIO dev: R2_ENDPOINT=http://localhost:9000
R2_ENDPOINT=

# ─── Email (SMTP) ──────────────────────────────────────────────────────────
# Leave empty for dev mode (emails logged to console, users auto-verified).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── OAuth2 (Optional) ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── URLs ───────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to localhost:3000,localhost:5173.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate Limiting (Optional Overrides) ─────────────────────────────────────
# RATE_LIMIT_AUTH=15
# RATE_LIMIT_WRITE=60
# RATE_LIMIT_READ=120
# RATE_LIMIT_OAUTH=30

# ─── Server ─────────────────────────────────────────────────────────────────
# PORT=8080
# TRUSTED_PROXIES=127.0.0.1

# ─── Redis TLS (for managed Redis providers like Upstash, ElastiCache) ──────
# REDIS_TLS_ENABLED=false
